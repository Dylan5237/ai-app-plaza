#!/usr/bin/env bash
# Project-owned Git safety guard; no APO dependency.
set -euo pipefail
remote_name="${1:-}"
remote_url="${2:-}"
zero="0000000000000000000000000000000000000000"
deny() { echo "ai-app-plaza pre-push: $*" >&2; exit 1; }
[[ "$remote_name" == "origin" ]] || deny "unclassified remote; verify its role before pushing"
case "$remote_url" in
  https://github.com/Dylan5237/ai-app-plaza|https://github.com/Dylan5237/ai-app-plaza.git|git@github.com:Dylan5237/ai-app-plaza.git|ssh://git@github.com/Dylan5237/ai-app-plaza.git) ;;
  *) deny "authority URL is not the configured GitHub repository" ;;
esac
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_ref:-}" ]] || continue
  [[ "$remote_ref" != "refs/heads/main" ]] || deny "direct push or deletion of main is forbidden; use a PR"
  [[ "$local_sha" != "$zero" ]] || continue
  if [[ "$remote_sha" != "$zero" && "$remote_sha" != "$local_sha" ]]; then
    git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null || deny "non-fast-forward update is forbidden"
  fi
done
