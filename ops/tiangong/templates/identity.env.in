# Keep existing database, GitLab and persistent secret EnvironmentFiles loaded first.
NODE_ENV=production
HOST=127.0.0.1
PORT=@@BACKEND_PORT@@
PUBLIC_ORIGIN=@@PORTAL_ORIGIN@@
PLAZA_PUBLIC_BASE_PATH=/plaza
PLAZA_TRUSTED_PROXY_IP=127.0.0.1
PLAZA_LOCAL=
PLAZA_LOCAL_MANAGEMENT=
PLAZA_INTRANET_MANAGEMENT=
PLAZA_PREVIEW_ADMIN_PROXY_IP=
PLAZA_HTTPS_ORIGIN=
TIANGONG_AUTH_ENABLED=true
TIANGONG_USERINFO_URL=@@PORTAL_ORIGIN@@/pedestal-service/inner/skyUser/findByToken
TIANGONG_SUCCESS_CODE=00000000
TIANGONG_TOKEN_STORAGE_KEY=sky-token
TIANGONG_ALLOWED_USER_TYPES=03,04
TIANGONG_WEB_SESSION_HOURS=8
# Set only in the private file if the exact verified account needs initial binding.
PLAZA_SUPER_ADMIN_ACCOUNT=
NODE_EXTRA_CA_CERTS=@@ROOT@@/public-trust/portal-ca-@@RELEASE@@.pem
