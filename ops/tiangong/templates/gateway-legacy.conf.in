# Anonymous source APIs stay at their original origin. Browser identity stays at Tiangong.
location ~ ^/api/(auth|identity|personal|access|management|operations|preview-admin)(/|$) {
    default_type application/json;
    return 403 '{"error":{"code":"PORTAL_ENTRY_REQUIRED","message":"Use the Tiangong Plaza entry."}}';
}
location ~ ^/api/publications/[^/]+/(confirm|retry)(/|$) {
    default_type application/json;
    return 403 '{"error":{"code":"PORTAL_ENTRY_REQUIRED","message":"Confirm in the Tiangong Plaza page."}}';
}
location /api/ {
    include @@ROOT@@/config/plaza-entry-state.conf;
    proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
    proxy_http_version 1.1;
    proxy_set_header Host @@PORTAL_HOST@@;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_set_header Cookie "";
    proxy_set_header X-Plaza-Portal-Token "";
    proxy_set_header Accept-Encoding "";
    proxy_hide_header Set-Cookie;
    proxy_redirect off;
    proxy_cache off;
    sub_filter_types application/json;
    sub_filter_once off;
    sub_filter '@@PORTAL_ORIGIN@@/plaza' '$scheme://$http_host';
    client_max_body_size 32m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    access_log off;
}
location = /plaza {
    return 308 @@PORTAL_ORIGIN@@/plaza/$is_args$args;
}
location / {
    return 308 @@PORTAL_ORIGIN@@/plaza$request_uri;
}
