# Inside the existing Plaza TLS server; keep its certificate and Host guard.
if ($http_host != "@@GATEWAY_IP@@:@@GATEWAY_TLS_PORT@@") { return 421; }
location ^~ /plaza/ {
    if ($realip_remote_addr != "@@PORTAL_PEER_IP@@") { return 403; }
    include @@ROOT@@/config/plaza-entry-state.conf;
    set_real_ip_from @@PORTAL_PEER_IP@@;
    real_ip_header X-Real-IP;
    real_ip_recursive off;
    proxy_pass http://127.0.0.1:@@BACKEND_PORT@@;
    proxy_http_version 1.1;
    proxy_set_header Host @@PORTAL_HOST@@;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    client_max_body_size 32m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    access_log off;
}
