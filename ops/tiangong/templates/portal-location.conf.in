# Insert inside the existing Tiangong HTTPS server; reuse its browser-facing TLS.
location = /plaza {
    return 302 /plaza/$is_args$args;
}
location ^~ /plaza/ {
    proxy_pass https://@@GATEWAY_IP@@:@@GATEWAY_TLS_PORT@@;
    proxy_http_version 1.1;
    proxy_set_header Host @@GATEWAY_IP@@:@@GATEWAY_TLS_PORT@@;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_ssl_server_name on;
    proxy_ssl_name @@GATEWAY_IP@@;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate @@PORTAL_GATEWAY_CA@@;
    client_max_body_size 32m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    access_log off;
}
