# Copy to .env (ignored); never commit real tokens or secret keys.
# Local mode binds loopback and persists embedded PostgreSQL (PGlite).
PLAZA_LOCAL=1
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
GITLAB_URL=https://gitlab.example.invalid
PLAZA_DATA_DIR=artifacts/plaza-local

# Non-local service: remove PLAZA_LOCAL, use external PostgreSQL and HTTPS by default.
# DATABASE_URL=postgresql://user:password@localhost:5432/plaza
# PLAZA_SECRET=<32+ cryptographically random characters; retain across restarts>
# ALLOW_INSECURE_GITLAB=1 # only for an explicitly trusted internal HTTP GitLab

# Trusted intranet trial only: this enables unencrypted HTTP only for a literal RFC1918 IPv4 PUBLIC_ORIGIN
# (10/8, 172.16/12, or 192.168/16). HTTP has no transport encryption; never use this for public access.
# ALLOW_INSECURE_PORTAL=1

# Optional additional HTTPS ingress on the SAME literal private IPv4 and a distinct Host/port.
# PUBLIC_ORIGIN remains the existing HTTP canonical address for authors, MCP and receipts.
# The TLS gateway connects from loopback, preserves Host/Origin, and overwrites X-Real-IP.
# Other connections cannot use the HTTPS alias, even with forged forwarded headers.
# PLAZA_HTTPS_ORIGIN=https://192.168.2.145:16490
# This ingress shares the same business APIs; canonical publication URLs stay on PUBLIC_ORIGIN.

# Optional passwordless management for a trusted private network. Remove PLAZA_LOCAL=1 above,
# configure the external PostgreSQL database and persistent secret, and restrict network access.
# Every visitor who can reach this portal can manage applications and publications.
# PLAZA_INTRANET_MANAGEMENT=1
# HOST=0.0.0.0
# PORT=16090
# PUBLIC_ORIGIN=http://192.168.2.145:16090
# ALLOW_INSECURE_PORTAL=1 # required only for HTTP; HTTPS to a private IPv4 is also supported

# Optional local MCP bridge. Set GitLab token in Host secret/environment configuration.
# PLAZA_URL=http://127.0.0.1:4173
# GITLAB_TOKEN=<existing authorized GitLab token; never put into chat>

# Optional managed publication: fixed namespace and server-only group authorization.
# Set all three together; never expose this token to authors, prompts or browser code.
# PLAZA_MANAGED_GROUP_ID=63
# PLAZA_MANAGED_GROUP_PATH=sky-efficiency-skills/ai-apps
# PLAZA_MANAGED_GITLAB_TOKEN=<server-only group access token>

# Preview management is read-only and immediately available to all portal visitors.
# No administrator password, session or enable switch is required.
# Optional: exact IP of a reverse proxy that overwrites X-Real-IP.
# When configured, management requests must come from that proxy with one valid client IP.
# Otherwise request limits use the direct socket IP. Public/author APIs keep trustProxy=false.
# PLAZA_PREVIEW_ADMIN_PROXY_IP=127.0.0.1
