{
  "name": "ai-app-plaza",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "generate": "python scripts/apply_compact_portal.py && node scripts/build_fuxi_portal.cjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run generate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test --test-concurrency=4 tests/*.test.ts",
    "dev:management-local": "node --import tsx scripts/preview-management-local.ts",
    "test:management:browser": "node --import tsx tests/management-browser.ts",
    "test:identity:browser": "node --import tsx tests/identity-browser.ts",
    "test:access:browser": "node --import tsx tests/ownership-sharing-browser.ts",
    "test:analytics:browser": "node --import tsx tests/analytics-browser.ts",
    "test:operations:browser": "node --import tsx tests/operations-dashboard-browser.ts",
    "dev:prototype": "npm run generate && vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx server/mcp.ts",
    "typecheck": "tsc -p tsconfig.server.json",
    "test:docs": "node --import tsx scripts/check-publishing-docs.mjs",
    "test:e2e": "node --import tsx tests/mainflow-browser.ts && node --import tsx tests/update-browser.ts && node --import tsx tests/preview-admin-browser.ts && node --import tsx tests/management-browser.ts && node --import tsx tests/admin-basics-browser.ts && node --import tsx tests/catalog-usage-browser.ts && node --import tsx tests/management-pagination-browser.ts && node --import tsx tests/distribution-browser.ts && npm run test:analytics:browser && npm run test:operations:browser && npm run test:identity:browser && node --import tsx tests/refresh-state-browser.ts && npm run test:access:browser",
    "test:distribution:browser": "node --import tsx tests/distribution-browser.ts",
    "dev:distribution-preview": "node --import tsx tests/distribution-browser.ts --serve",
    "test:prototype": "node tests/mock-v13-qa.cjs && node tests/publisher-v13-qa.cjs",
    "test:admin-basics:browser": "node --import tsx tests/admin-basics-browser.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "element-plus": "2.11.8",
    "fastify": "5.12.8",
    "ip-address": "10.7.6",
    "jsonc-parser": "3.3.1",
    "lucide": "1.17.0",
    "markdown-it": "15.0.3",
    "pg": "8.23.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue": "5.2.4",
    "playwright": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.5"
  }
}
