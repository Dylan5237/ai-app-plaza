{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI应用广场资料契约草案 v1",
  "description": "评审用结构约束；正式收录还需要语义、权限与固定版本来源核验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appKey", "name", "summary", "tags", "maintainers", "capabilities", "examples", "requirements", "limitations", "docs", "entries", "primaryEntry"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "appKey": {"$ref": "#/$defs/key"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "tags": {
      "type": "array", "maxItems": 12, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 32}
    },
    "maintainers": {
      "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 255}
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["scenarios", "inputs", "outputs"],
      "properties": {
        "scenarios": {"$ref": "#/$defs/nonEmptyTextList"},
        "inputs": {"$ref": "#/$defs/textList"},
        "outputs": {"$ref": "#/$defs/nonEmptyTextList"}
      }
    },
    "examples": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["request", "expectedResult"],
        "properties": {
          "request": {"$ref": "#/$defs/text"},
          "expectedResult": {"$ref": "#/$defs/text"}
        }
      }
    },
    "requirements": {"$ref": "#/$defs/textList"},
    "limitations": {"$ref": "#/$defs/textList"},
    "docs": {
      "type": "object", "additionalProperties": false,
      "required": ["readme", "usage"],
      "properties": {
        "readme": {"$ref": "#/$defs/repoPath"},
        "usage": {"$ref": "#/$defs/repoPath"}
      }
    },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"oneOf": [{"$ref": "#/$defs/webEntry"}, {"$ref": "#/$defs/agentEntry"}]}
    },
    "primaryEntry": {"$ref": "#/$defs/key"}
  },
  "$defs": {
    "key": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "textList": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "nonEmptyTextList": {"allOf": [{"$ref": "#/$defs/textList"}, {"minItems": 1}]},
    "repoPath": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\:\\x00-\\x1F]+$",
      "description": "仓库根相对路径；服务端还须检查空段、文件类型和固定 commit 下的存在性。"
    },
    "httpUrl": {"type": "string", "maxLength": 2048, "format": "uri", "pattern": "^https?://"},
    "webEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "label", "url"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "kind": {"const": "web"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "url": {"$ref": "#/$defs/httpUrl"}
      }
    },
    "agentEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "label", "instructionsPath", "compatibility"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "kind": {"const": "agent"},
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "instructionsPath": {"$ref": "#/$defs/repoPath"},
        "compatibility": {"$ref": "#/$defs/nonEmptyTextList"},
        "artifacts": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "sha256"],
            "properties": {
              "url": {"$ref": "#/$defs/httpUrl"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  }
}
